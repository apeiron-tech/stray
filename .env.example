# Archive object storage. Supply credentials privately; never commit populated values.
STRAY_ARCHIVE_OBJECT_STORE_ENDPOINT=
STRAY_ARCHIVE_OBJECT_STORE_BUCKET=
STRAY_ARCHIVE_OBJECT_STORE_ACCESS_KEY_ID=
STRAY_ARCHIVE_OBJECT_STORE_SECRET_ACCESS_KEY=

# Omit these switches to retain the default db behavior. Uncomment with a valid value.
# Write accepts db / both / r2; reads accept db / r2-first.
# STRAY_ARCHIVE_BODY_WRITE=
# STRAY_ARCHIVE_BODY_READ_LOOKUP=
# STRAY_ARCHIVE_BODY_READ_RESULT=
# STRAY_ARCHIVE_BODY_READ_TERMINAL=

# Read timeout defaults to 2 seconds; upload keeps its separate timeout.
# STRAY_ARCHIVE_R2_READ_TIMEOUT_S=

# Optional changed-path reporting (shares archive concurrency and lookup read mode).
STRAY_ARCHIVE_CHANGE_OBSERVATION_ENABLED=true

# Optional operator cache age ceilings by exact endpoint ID (seconds).
STRAY_ARCHIVE_SERVE_MAX_AGE_S={}

# Optional SQLite / PostgreSQL read datasource. Empty reuses the primary for opted-in reads.
# Existing queries and all writes still use STRAY_DATABASE_URL; this does not route them automatically.
# Supply the real URL privately, e.g. postgresql://user:password@replica-host/database.
# SQLite: sqlite+aiosqlite:///file:replica.db?mode=ro&uri=true opens an existing file read-only.
# You must provision and synchronize the datasource separately; this URL does not replicate data.
STRAY_READ_DATABASE_URL=
# Optional PostgreSQL pool sizing: STRAY_DB_POOL_OVERRIDES=read.pool_size=2,read.max_overflow=0
