{
  "exception_handlers": [
    {
      "exception": "starlette.exceptions.HTTPException",
      "handler": "stray.api._mark_stray_own_errors"
    },
    {
      "exception": "fastapi.exceptions.RequestValidationError",
      "handler": "fastapi.exception_handlers.request_validation_exception_handler"
    },
    {
      "exception": "fastapi.exceptions.WebSocketRequestValidationError",
      "handler": "fastapi.exception_handlers.websocket_request_validation_exception_handler"
    },
    {
      "exception": "builtins.OverflowError",
      "handler": "stray.api._id_out_of_range"
    },
    {
      "exception": "sqlalchemy.exc.TimeoutError",
      "handler": "stray.api._pool_saturated"
    }
  ],
  "middleware": [
    {
      "args": [],
      "class": "stray.mcp.NormalizeDirectoryMCPPath",
      "kwargs": {}
    },
    {
      "args": [],
      "class": "stray.api._BodyDecodeMiddleware",
      "kwargs": {}
    },
    {
      "args": [],
      "class": "stray.api._SecurityHeadersMiddleware",
      "kwargs": {}
    },
    {
      "args": [],
      "class": "stray.api._LegacyHostRedirectMiddleware",
      "kwargs": {}
    }
  ]
}
